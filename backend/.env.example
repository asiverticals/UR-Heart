# ==============================================================================
# UR-HEART SANCTUARY & CORE ENGINE CONFIGURATION (EXAMPLE TEMPLATE)
# ==============================================================================

# Core Deployment Environment
APP_NAME="UR-Heart Core Engine"
PROJECT_NAME="UR-Heart Sanctuary"
ENVIRONMENT="development"
DEBUG="false"
PORT=10000
TESTING=false
API_V1_PREFIX="/api/v1"

# Authentication & Cryptographic Keys
JWT_SECRET_KEY="replace_with_min_32_char_hex_or_secret"
SECRET_KEY="replace_with_min_32_char_hex_or_secret"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
WS_TICKET_EXPIRE_SECONDS=60
WS_BASE_URL="wss://urheart.app/ws/chat"

# Supabase PgBouncer Pooler (Port 6543) & Storage
SUPABASE_URL="https://your_project_id.supabase.co"
SUPABASE_STORAGE_BUCKET="ur-heart-media"
SUPABASE_PGBOUNCER_URL="postgresql+asyncpg://postgres.your_project_id:your_db_password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres"
DATABASE_URL="postgresql+asyncpg://postgres.your_project_id:your_db_password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"
SUPABASE_ANON_KEY="your_supabase_anon_key"

# Cloudflare R2 Media Storage (Optional Secondary Adapter)
CLOUDFLARE_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="ur-heart-media"
R2_PUBLIC_DOMAIN="https://media.urheart.app"

# Groq Cloud LPU & Voice Whisper
GROQ_API_KEY="gsk_your_groq_api_key"
GROQ_API_URL="https://api.groq.com/openai/v1/chat/completions"
GROQ_VOICE_API_KEY="your_groq_voice_api_key"
GROQ_WHISPER_URL="https://api.groq.com/openai/v1/audio/transcriptions"

# OpenRouter Free Failover
OPENROUTER_API_KEY="sk-or-your_openrouter_api_key"
OPENROUTER_API_URL="https://openrouter.ai/api/v1/chat/completions"

# Google AI Studio Gemini Engine
GEMINI_API_KEY="AIzaSy_your_gemini_api_key"
GEMINI_API_URL="https://generativelanguage.googleapis.com/v1beta/models"

# Firebase Admin & Storage
FIREBASE_PROJECT_ID="ur-heart-your_project_id"
FIREBASE_STORAGE_BUCKET="ur-heart-your_project_id.firebasestorage.app"
FIREBASE_CREDENTIALS_PATH="backend/serviceAccountKey.json"
FIREBASE_SERVICE_ACCOUNT_B64=""
FIREBASE_SERVICE_ACCOUNT_JSON="{}"
FIREBASE_WEB_API_KEY="your_firebase_web_api_key"
GOOGLE_SERVER_CLIENT_ID=""

# Resend Transactional Email Engine
RESEND_API_KEY="re_your_resend_api_key"
RESEND_FROM="UR-Heart Sanctuary <verify@urheart.app>"

# Google Gmail SMTP Relay
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your_email@gmail.com"
SMTP_PASSWORD="your_app_password"
SMTP_FROM="UR-Heart Sanctuary <verify@urheart.app>"

# Brevo (Sendinblue) Fallback Engine
BREVO_API_KEY="xkeysib-your_brevo_api_key"
BREVO_SMTP_HOST="smtp-relay.brevo.com"
BREVO_SMTP_PORT=587
BREVO_SMTP_USER="your_brevo_smtp_user"
BREVO_SMTP_PASSWORD="your_brevo_smtp_password"

# Testmail.app Automated E2E Testing Suite
TESTMAIL_API_KEY="your_testmail_api_key"
TESTMAIL_NAMESPACE="your_namespace"

# Ad Network SSV Secrets
ADMOB_VERIFIER_KEYS_URL="https://www.gstatic.com/admob/reward/verifier-keys.json"
META_AUDIENCE_SSV_SECRET="your_meta_audience_ssv_secret"
META_APP_SECRET="your_meta_app_secret"
UNITY_ADS_SSV_SECRET="your_unity_ads_ssv_secret"
UNITY_ADS_SECRET="your_unity_ads_secret"
CHARTBOOST_SSV_SECRET="your_chartboost_ssv_secret"
CHARTBOOST_APP_SECRET="your_chartboost_app_secret"
LIFTOFF_SSV_SECRET="your_liftoff_ssv_secret"
LIFTOFF_API_SECRET="your_liftoff_api_secret"

# Superadmin Sentinel Gate
SUPERADMIN_EMAIL="superadmin@example.com"
ADMIN_SUPERUSER_EMAIL="superadmin@example.com"
SUPERADMIN_SECRET_KEY="placeholder_superadmin_secret_key"

# Sentry Error Monitoring
SENTRY_DSN=""

# Billing Webhook Secrets & Gateways
PAYMENT_GATEWAY="razorpay"
REVENUECAT_WEBHOOK_SECRET="placeholder_revenuecat_webhook_secret"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET="placeholder_razorpay_webhook_secret"
RAZORPAY_MERCHANT_NAME="UR-Heart Sanctuary"
RAZORPAY_THEME_COLOR="#2E6F5E"
STRIPE_WEBHOOK_SECRET="placeholder_stripe_webhook_secret"
CASHFREE_CLIENT_ID=""
CASHFREE_SECRET_KEY=""

# Scale Condition Feature Gates (Condition C1 & C2)
BLIND_DATE_MIN_ACTIVE_USERS=1000000
ENABLE_BLIND_DATE_OVERRIDE=false
ENABLE_GLOBAL_USD_BILLING=false
PASSPORT_MIN_ACTIVE_USERS=1000000
ENABLE_PASSPORT_OVERRIDE=false
